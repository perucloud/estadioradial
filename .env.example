APP_NAME="Estación Radial"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://estacionradial.test
APP_TIMEZONE=America/Lima
ASSET_URL=https://estacionradial.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Conexiones independientes para una migración segura de SQLite a MySQL.
# MIGRATION_SQLITE_DATABASE=/ruta/absoluta/database/database.sqlite
MIGRATION_MYSQL_HOST=127.0.0.1
MIGRATION_MYSQL_PORT=3306
MIGRATION_MYSQL_DATABASE=estacionradial
# MIGRATION_MYSQL_USERNAME=root
# MIGRATION_MYSQL_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=estacionradial.test
SESSION_SECURE_COOKIE=true

ADMIN_CAPTCHA_ENABLED=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Use GPL only when the complete project is compatible with GPL 2.0+.
# Otherwise, provide the commercial self-hosted license key from CKEditor.
VITE_CKEDITOR_LICENSE_KEY=GPL

# Slider: automatic | manual
